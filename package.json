{
  "name": "kick-chat-translator",
  "version": "2.2.0",
  "private": true,
  "description": "Real-time multi-provider chat translator for Kick.com — pro Chrome/Firefox extension.",
  "license": "MIT",
  "author": "Pkkls",
  "homepage": "https://github.com/Pkkls/kick-chat-translator",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pkkls/kick-chat-translator.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && tsx scripts/bundle-content.ts",
    "build:firefox": "cross-env BROWSER=firefox vite build && tsx scripts/bundle-content.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "icons": "tsx scripts/generate-icons.ts",
    "pack": "tsx scripts/pack.ts",
    "pack:firefox": "cross-env BROWSER=firefox tsx scripts/pack.ts",
    "package:all": "npm run build && npm run pack && npm run build:firefox && npm run pack:firefox",
    "release:check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.1.42",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "franc-min": "^6.2.0",
    "idb-keyval": "^6.2.5",
    "preact": "^10.24.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
